<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug build only: allows connecting Android Emulator to local dev server (http://10.0.2.2:3000).
         Release builds strictly enforce android:usesCleartextTraffic="false" (HTTPS only). -->
