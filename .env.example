# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ZENTRIX Owner Admin Credentials (set in production secrets; overrides first-run setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: External URL Threat Intelligence API key (e.g. Google Safe Browsing v4)
# Without this key, ZENTRIX runs local heuristic & lookalike domain verification only.
SAFE_BROWSING_API_KEY=

# Optional: SQLite database file path (defaults to ./data/zentrix.db)
ZENTRIX_DB_PATH=

